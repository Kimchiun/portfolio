---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { publishedProjects } from '../data/projects';
import { sharing } from '../data/sharing';

const [featured, ...rest] = publishedProjects;
const featOut = featured?.outcomes[0];
---

<BaseLayout>
  <div class="site">
    <div class="progress" aria-hidden="true">
      <span class="progress__bar" data-progress></span>
    </div>

    <header class="nav">
      <a class="nav__name" href="#top">{profile.name}</a>
      <nav class="nav__links" aria-label="섹션">
        <a href="#projects">프로젝트</a>
        <a href="#experience">경력</a>
        <a href="#capability">역량</a>
        <a href="#contact">연락</a>
      </nav>
    </header>

    <main id="top">
      <!-- Hero scrub -->
      <section class="hero" aria-label="소개" data-band="mist">
        <div class="hero__track" data-scrub>
          <div class="hero__pin">
            <div class="hero__frame">
              <div class="hero__copy">
                <p class="meta">{profile.years} · {profile.role}</p>
                <h1 class="hero__name">{profile.name}</h1>
                <p class="hero__role">{profile.headline}</p>
                <p class="hero__summary">{profile.summary}</p>
              </div>
              <figure class="hero__media" data-drift>
                <div class="hero__mask">
                  <img
                    src="/portrait.png?v=7"
                    alt={`${profile.name} 프로필 사진`}
                    width="530"
                    height="954"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              </figure>
            </div>
            <p class="hero__cue" aria-hidden="true">Scroll</p>
          </div>
        </div>
      </section>

      <!-- Proof strip — numbers from existing project outcomes only -->
      <section class="proof" aria-label="일하는 관점" data-band="sheet">
        <div class="proof__inner">
          <div class="proof__item" data-reveal>
            <p class="proof__label">Problem Solving</p>
            <p class="proof__value proof__value--copy">
              복잡한 문제를<br />원인까지 추적합니다.
            </p>
          </div>
          <div class="proof__item" data-reveal>
            <p class="proof__label">Test Strategy</p>
            <p class="proof__value proof__value--copy">
              테스트보다<br />테스트 체계를 만듭니다.
            </p>
          </div>
          <div class="proof__item" data-reveal>
            <p class="proof__label">Knowledge Sharing</p>
            <p class="proof__value proof__value--copy">
              개인의 경험을<br />팀의 자산으로 만듭니다.
            </p>
          </div>
        </div>
      </section>

      <!-- Projects -->
      <section class="projects" id="projects" aria-label="프로젝트" data-band="shift">
        <div class="section-head wrap">
          <h2 class="section-label">Projects</h2>
          <p class="section-note">대표 케이스 {publishedProjects.length}건</p>
        </div>

        {
          featured ? (
            <article class="feature" data-band="night">
              <div class="feature__track" data-scrub>
                <div class="feature__pin">
                  <a
                    class="feature__link"
                    href={`/projects/${featured.slug}`}
                    data-drift
                  >
                    <div class="feature__media">
                      <img
                        src={featured.thumbnail}
                        alt=""
                        width="1600"
                        height="900"
                        loading="lazy"
                        decoding="async"
                        style={`view-transition-name: project-${featured.slug}`}
                      />
                    </div>
                    <div class="feature__copy">
                      <p class="meta">{featured.periodHint}</p>
                      <h3 class="feature__title">{featured.shortTitle}</h3>
                      {featOut ? (
                        <p class="feature__out">
                          <span>{featOut.label}</span>
                          {featOut.before} → {featOut.after}
                        </p>
                      ) : null}
                      <span class="feature__go">프로젝트 보기</span>
                    </div>
                  </a>
                </div>
              </div>
            </article>
          ) : null
        }

        <div class="cross wrap">
          {
            rest.map((project, i) => {
              const out = project.outcomes[0];
              const flip = i % 2 === 1;
              const offset = i === rest.length - 1;
              return (
                <article
                  class:list={[
                    'cross__item',
                    flip && 'cross__item--flip',
                    offset && 'cross__item--offset',
                  ]}
                  data-reveal
                >
                  <a
                    class="cross__link"
                    href={`/projects/${project.slug}`}
                    data-drift
                  >
                    <div class="cross__media">
                      <img
                        src={project.thumbnail}
                        alt=""
                        width="1200"
                        height="675"
                        loading="lazy"
                        decoding="async"
                        style={`view-transition-name: project-${project.slug}`}
                      />
                    </div>
                    <div class="cross__copy">
                      <p class="meta">{project.periodHint}</p>
                      <h3 class="cross__title">{project.shortTitle}</h3>
                      <p class="cross__line">{project.oneLiner}</p>
                      {out ? (
                        <p class="cross__out">
                          {out.before} → {out.after}
                        </p>
                      ) : null}
                      <span class="cross__go">자세히</span>
                    </div>
                  </a>
                </article>
              );
            })
          }
        </div>
      </section>

      <!-- Experience -->
      <section class="experience" id="experience" aria-label="경력" data-band="mist">
        <div class="wrap">
          <h2 class="section-label">Experience</h2>
          <ol class="jobs">
            {
              profile.experience.map((job) => (
                <li class="job" data-job data-reveal>
                  <div class="job__rail" aria-hidden="true">
                    <span class="job__dot" />
                  </div>
                  <div class="job__body">
                    <div class="job__head">
                      <h3 class="job__co">
                        {job.company}
                        {job.companyEn ? (
                          <span class="job__en"> · {job.companyEn}</span>
                        ) : null}
                      </h3>
                      <p class="job__when">{job.period}</p>
                    </div>
                    <p class="job__role">
                      {job.role} · {job.products}
                    </p>
                    <p class="job__focus">{job.focus}</p>
                    <ul class="job__bullets">
                      {job.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Capability: sharing + skills -->
      <div id="capability">
        <section class="sharing" id="sharing" aria-label="지식 전수" data-band="sheet">
          <div class="wrap">
            <header class="sharing__head">
              <h2 class="section-label">지식 전수</h2>
              <p class="sharing__title">{sharing.title}</p>
              <p class="sharing__lead">{sharing.oneLiner}</p>
              <a class="text-link" href="/sharing">이야기 자세히 보기</a>
            </header>

            <div class="sharing__items">
              {
                sharing.activities.map((a) => (
                  <article class="sharing__item" data-reveal>
                    <a class="sharing__link" href={`/sharing#${a.slug}`} data-drift>
                      <div class="sharing__media">
                        <img
                          src={a.thumbnail}
                          alt=""
                          width="640"
                          height="360"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="sharing__copy">
                        <p class="meta">{a.status}</p>
                        <h3 class="sharing__name">{a.title}</h3>
                        {'talkTitle' in a && a.talkTitle ? (
                          <p class="sharing__talk">{a.talkTitle}</p>
                        ) : null}
                        <p class="sharing__sum">{a.summary}</p>
                      </div>
                    </a>
                    <div class="sharing__actions">
                      <a class="sharing__go" href={`/sharing#${a.slug}`}>
                        자세히
                      </a>
                      {'href' in a && a.href ? (
                        <a
                          class="sharing__ext"
                          href={a.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {a.hrefLabel ?? '자세히'} →
                        </a>
                      ) : null}
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <section class="stack" id="stack" aria-label="스킬" data-band="mist">
          <div class="wrap">
            <h2 class="section-label">스킬</h2>
            <ul class="skills">
              {
                profile.skills.map((g) => (
                  <li class="skills__row" data-reveal>
                    <h3 class="skills__label">{g.group}</h3>
                    <p class="skills__items">{g.items.join(' · ')}</p>
                  </li>
                ))
              }
            </ul>
            <div class="stack__meta">
              <div data-reveal>
                <h2 class="section-label">학력</h2>
                <p class="aside__lead">{profile.education.school}</p>
                <p class="aside__sub">{profile.education.detail}</p>
              </div>
              <div data-reveal>
                <h2 class="section-label">수상</h2>
                <ul class="aside__list">
                  {profile.awards.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- How -->
      <section class="how" id="how" aria-label="일하는 방식" data-band="mist">
        <div class="wrap">
          <h2 class="section-label">How I work</h2>
          <ul class="habits">
            {
              profile.howIWork.map((item, i) => (
                <li data-reveal>
                  <span class="habits__n">{String(i + 1).padStart(2, '0')}</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Contact -->
      <section class="contact" id="contact" aria-label="연락" data-band="night">
        <div class="wrap contact__inner" data-reveal>
          <div class="contact__head">
            <h2 class="contact__title">Contact</h2>
            <p class="contact__sign">{profile.name} · {profile.nameEn}</p>
          </div>
          <address class="contact__channels">
            <a class="contact__channel" href={`mailto:${profile.contact.email}`}>
              <span class="contact__key">Email</span>
              <span class="contact__val">{profile.contact.email}</span>
            </a>
            <a class="contact__channel" href={`tel:${profile.contact.phoneHref}`}>
              <span class="contact__key">Phone</span>
              <span class="contact__val">{profile.contact.phone}</span>
            </a>
            <div class="contact__channel contact__channel--static">
              <span class="contact__key">Based in</span>
              <span class="contact__val">{profile.contact.location}</span>
            </div>
          </address>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .site {
    isolation: isolate;
  }

  .wrap {
    width: min(100% - 2 * var(--rail), var(--max));
    margin-inline: auto;
  }

  .meta {
    margin: 0 0 0.65rem;
    font-size: 0.75rem;
    font-weight: 560;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mute);
    font-variant-numeric: tabular-nums;
  }

  .section-label {
    margin: 0 0 1.25rem;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 3.5rem 0 1.5rem;
  }

  .section-head .section-label {
    margin: 0;
  }

  .section-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--mute);
  }

  .progress {
    position: fixed;
    inset: 0 0 auto;
    height: 2px;
    z-index: 60;
    pointer-events: none;
  }

  .progress__bar {
    display: block;
    height: 100%;
    width: calc(var(--scroll-p, 0) * 100%);
    background: var(--teal);
  }

  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--nav-h);
    padding-inline: var(--rail);
    background: rgb(244 245 247 / 0.88);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(10px);
  }

  .nav__name {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.15rem;
    font-size: 0.82rem;
    font-weight: 520;
    color: var(--mute);
  }

  .nav__links a {
    text-decoration: none;
  }

  .nav__links a:hover {
    color: var(--ink);
  }

  /* Hero */
  .hero__track {
    --p: 0;
    height: 155vh;
  }

  .hero__pin {
    position: sticky;
    top: var(--nav-h);
    min-height: calc(100dvh - var(--nav-h));
    display: grid;
    align-content: center;
    padding: 0 0 2rem;
  }

  .hero__frame {
    width: min(100%, var(--max));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.7fr);
    gap: clamp(1.75rem, 4vw, 3.25rem);
    align-items: center;
    padding: 2rem var(--rail) 0;
    background: transparent;
    border: 0;
    transform: translateY(calc(var(--p) * -1.5rem));
  }

  .hero__copy {
    width: min(100%, 36rem);
    justify-self: start;
    padding-right: 0;
  }

  .hero__name {
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .hero__role {
    margin: 0.85rem 0 0;
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    color: var(--teal);
  }

  .hero__summary {
    margin: 1.1rem 0 0;
    max-width: 34rem;
    font-size: 0.98rem;
    color: var(--mute);
  }

  .hero__media {
    justify-self: end;
    width: min(100%, 18.5rem);
    height: auto;
    max-height: none;
    margin: 0;
  }

  .hero__mask {
    overflow: hidden;
    height: auto;
    border-radius: 0.25rem;
    border: 0;
    background: transparent;
    clip-path: none;
  }

  .hero__mask img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center top;
    transform: scale(calc(1.01 + var(--p) * 0.02));
    transition: transform 0.55s var(--ease-out);
  }

  .hero__cue {
    margin: 1.25rem auto 0;
    text-align: center;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
    opacity: calc(1 - var(--p) * 1.4);
  }

  /* Proof */
  .proof {
    background: var(--sheet);
    border-block: 1px solid var(--line);
    padding: 3rem var(--rail);
  }

  .proof__inner {
    width: min(100%, var(--max));
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .proof__item {
    padding: 0 1.75rem;
    border-left: 1px solid var(--line);
  }

  .proof__item:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .proof__item:last-child {
    padding-right: 0;
  }

  .proof__label {
    margin: 0 0 0.65rem;
    font-size: 0.75rem;
    font-weight: 560;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .proof__value {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    color: var(--brass);
    font-variant-numeric: tabular-nums;
  }

  .proof__value--copy {
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.4;
    color: var(--ink);
  }

  .proof__value--pair {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.5rem;
  }

  .proof__arrow {
    color: var(--mute);
    font-weight: 500;
  }

  .proof__note {
    margin: 0.45rem 0 0;
    font-size: 0.85rem;
    color: var(--mute);
  }

  /* Projects feature */
  .projects {
    background: var(--shift);
    padding-bottom: 4rem;
  }

  .feature {
    background: var(--night);
    color: #e8eaed;
  }

  .feature .meta {
    color: rgb(232 234 237 / 0.55);
  }

  .feature__track {
    --p: 0;
    height: 170vh;
  }

  .feature__pin {
    position: sticky;
    top: var(--nav-h);
    min-height: calc(100dvh - var(--nav-h));
    display: grid;
    align-items: stretch;
  }

  .feature__link {
    display: grid;
    grid-template-columns: minmax(0, 1.9fr) minmax(16rem, 0.85fr);
    min-height: calc(100dvh - var(--nav-h));
    text-decoration: none;
    color: inherit;
  }

  .feature__media {
    overflow: hidden;
    clip-path: inset(calc((1 - var(--p)) * 8%) round 0);
  }

  .feature__media img {
    width: 100%;
    height: 100%;
    min-height: calc(100dvh - var(--nav-h));
    object-fit: cover;
    object-position: center;
    transform: scale(calc(1 + var(--p) * 0.06));
    transition: transform 0.5s var(--ease-out);
  }

  .feature__link:hover .feature__media img {
    --img-scale: 1.05;
    transform: scale(1.05);
  }

  .feature__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-left: 1px solid rgb(232 234 237 / 0.12);
  }

  .feature__title {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .feature__out {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgb(232 234 237 / 0.72);
  }

  .feature__out span {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.75rem;
    font-weight: 560;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .feature__go {
    margin-top: 1.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #9ec9d8;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .feature__go::after {
    content: " →";
  }

  /* Cross projects */
  .cross {
    display: grid;
    gap: 5rem;
    padding: 4.5rem 0 1rem;
  }

  .cross__link {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 0.9fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    text-decoration: none;
  }

  .cross__item--flip .cross__link {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.75fr);
  }

  .cross__item--flip .cross__media {
    order: 2;
  }

  .cross__item--flip .cross__copy {
    order: 1;
  }

  .cross__item--offset {
    width: min(100%, 92%);
    margin-inline: auto 0;
  }

  .cross__media {
    overflow: hidden;
    border-radius: 0.35rem;
    border: 1px solid var(--line);
    background: var(--mist);
    aspect-ratio: 16 / 10;
    min-height: 18rem;
  }

  .cross__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s var(--ease-out);
  }

  .cross__link:hover .cross__media img {
    transform: scale(1.04);
  }

  .cross__title {
    margin: 0;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .cross__line {
    margin: 0.85rem 0 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--mute);
  }

  .cross__out {
    margin: 0.85rem 0 0;
    font-size: 0.9rem;
    font-weight: 560;
    color: var(--ink);
  }

  .cross__go {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cross__go::after {
    content: " →";
  }

  /* Experience */
  .experience {
    padding: 4.5rem 0;
    background: var(--mist);
  }

  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .job {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 1.25rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
    opacity: 0.55;
    transition: opacity 0.45s var(--ease-out);
  }

  .job.is-active,
  .job:hover {
    opacity: 1;
  }

  .job:last-child {
    border-bottom: 1px solid var(--line);
  }

  .job__rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .job__dot {
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.45rem;
    border-radius: 50%;
    border: 1.5px solid var(--teal);
    background: transparent;
    transition: background 0.35s var(--ease-out);
  }

  .job.is-active .job__dot {
    background: var(--teal);
  }

  .job__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
  }

  .job__co {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .job__en {
    font-weight: 450;
    color: var(--mute);
  }

  .job__when {
    margin: 0;
